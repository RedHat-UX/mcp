{
  "$schema": "https://www.designtokens.org/schemas/2025.10.json",
  "$description": "Hand-normalized subset of @rhds/tokens@3.2.0. Aliases are preserved and every token has an explicit $type.",
  "color": {
    "$type": "color",
    "red": {
      "50": {
        "$value": "#ff0000",
        "$description": "RHDS brand red, 50.",
        "$type": "color"
      },
      "60": {
        "$value": "#cc0000",
        "$description": "RHDS brand red, 60.",
        "$type": "color"
      }
    },
    "brand": {
      "$value": "{color.red.50}",
      "$description": "Alias for the primary brand color.",
      "$type": "color"
    },
    "interactive": {
      "$value": "{color.brand}",
      "$description": "Alias chain used by interactive surfaces.",
      "$type": "color"
    }
  },
  "space": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      },
      "$description": "Small spacing step.",
      "$type": "dimension"
    },
    "md": {
      "$value": {
        "value": 1,
        "unit": "rem"
      },
      "$description": "Medium spacing step.",
      "$type": "dimension"
    }
  },
  "border": {
    "radius": {
      "$type": "dimension",
      "default": {
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Default border radius.",
        "$type": "dimension"
      }
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.5,
      "$description": "Disabled control opacity.",
      "$type": "number"
    }
  }
}
