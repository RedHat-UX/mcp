{
  "schemaVersion": "2.1.0",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "./mixins/fancy.js",
      "declarations": [
        {
          "kind": "mixin",
          "customElement": true,
          "name": "FancyMixin",
          "description": "Adds inherited API.",
          "attributes": [
            {
              "name": "fancy",
              "type": { "text": "boolean" },
              "description": "Inherited attribute."
            }
          ],
          "events": [
            {
              "name": "fancy-change",
              "type": { "text": "CustomEvent" },
              "description": "Inherited event."
            }
          ],
