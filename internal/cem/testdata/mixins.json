            {
              "name": "fancy-slot",
              "description": "Inherited slot."
            }
          ],
          "cssParts": [
            {
              "name": "fancy-part",
              "description": "Inherited part."
            }
          ],
          "cssProperties": [
            {
              "name": "--fancy-color",
              "description": "Inherited property."
            }
          ]
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "./rh-fancy/rh-fancy.js",
      "declarations": [
        {
          "kind": "class",
          "customElement": true,
          "name": "RhFancy",
